			<Item class="ModuleScript" referent="RBXFB702DD9A35D4FCCBBB6B48A18C14839">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- ballpropertions.luau - module script with ball propertions
local ballProperties = {
	["Size"] = Vector3.new(8,8,8),
	["Material"] = Enum.Material.Slate,
	["Transparency"] = 0.6,
	["Speed"] = 30
}

return ballProperties]]></ProtectedString>
