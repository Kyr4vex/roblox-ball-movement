		<Item class="Script" referent="RBX9764394233724A429CCA130C695474FF">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ballserver.luau - server side ig
local bridge = game:GetService("ReplicatedStorage"):WaitForChild("BallBridge")

-- // ball properties
local ballProperties = require(script.BallPropertions)

game:GetService("Players").PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		-- // some vars
		local hrp = character:WaitForChild("HumanoidRootPart")
		-- // ball creation
		local ball = Instance.new("Part")
		ball.Name = "Ball"
		ball.Shape = Enum.PartType.Ball
		ball.Size = ballProperties.Size
		ball.Position = character:WaitForChild("HumanoidRootPart").Position
		ball.Anchored = false
		ball.CanCollide = true
		ball.Material = ballProperties.Material
		ball.Transparency = ballProperties.Transparency
		-- // humanoid propertions
		character:FindFirstChildOfClass("Humanoid").PlatformStand = true
		-- // ball attachment
		local attachmentRoot = Instance.new("Attachment")
		attachmentRoot.Name = "RootAttachment"
		attachmentRoot.Parent = hrp
		local attachmentBall = Instance.new("Attachment")
		attachmentBall.Name = "BallAttachment"
		attachmentBall.Parent = ball
		-- // socket
		local socket = Instance.new("BallSocketConstraint")
		socket.Attachment0 = attachmentRoot
		socket.Attachment1 = attachmentBall
		socket.Parent = hrp
		-- // linearvelocity
		local moveAttachment = Instance.new("Attachment")
		moveAttachment.Name = "MoveAttachment"
		moveAttachment.Parent = ball
		local linearVelocity = Instance.new("LinearVelocity")
		linearVelocity.Name = "BallMovement"
		linearVelocity.Attachment0 = moveAttachment
		linearVelocity.MaxForce = 200000
		linearVelocity.VectorVelocity = Vector3.zero
		linearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
		linearVelocity.PrimaryTangentAxis = Vector3.new(1, 0, 0)
		linearVelocity.SecondaryTangentAxis = Vector3.new(0, 0, 1)
		linearVelocity.Parent = ball
		-- // final steps
		ball.Parent = character
	end)
end)
bridge.OnServerEvent:Connect(function(player, finaldir)
	local character = player.Character
	local ball = character:FindFirstChild("Ball") :: BasePart
	local lv = ball:FindFirstChild("BallMovement") :: LinearVelocity
	if lv then
		lv.PlaneVelocity = Vector2.new(finaldir.X * ballProperties.Speed, finaldir.Z * ballProperties.Speed)
	end
end)
]]></ProtectedString>
