		<Item class="LocalScript" referent="RBX097513DC553445AFAB2841D1E58AC12C">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ballclient.luau - client side ig
local bridge = game:GetService("ReplicatedStorage"):WaitForChild("BallBridge")
local player = game:GetService("Players").LocalPlayer
local runservice = game:GetService("RunService")

local lastMoveDirection = Vector3.new(0, 0, 0)

runservice.RenderStepped:Connect(function()
	local character = player.Character
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local currentMoveDirection = humanoid.MoveDirection
	if currentMoveDirection ~= lastMoveDirection then
		bridge:FireServer(currentMoveDirection)
		lastMoveDirection = currentMoveDirection
	end
end)
]]></ProtectedString>
